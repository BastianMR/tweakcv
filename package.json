{
  "name": "tweakcv",
  "version": "0.1.0",
  "description": "Local open-source app to build your personal CV database and generate ATS-optimized tailored CVs with your own AI",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"node --import tsx --watch src/server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "node --import tsx src/server/index.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "bench": "node --import tsx scripts/bench.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@jsonresume/schema": "^1.2.1",
    "@tanstack/react-query": "^5.102.0",
    "ajv": "^8.17.1",
    "better-sqlite3": "^13.0.3",
    "handlebars": "^4.7.9",
    "hono": "^4.13.3",
    "openai": "^7.5.0",
    "puppeteer": "^25.8.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.0",
    "tsx": "^4.20.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.5.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.35.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.43.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "puppeteer@25.8.0": true,
    "better-sqlite3@13.0.3": true
  }
}
